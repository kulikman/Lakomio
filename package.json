{
  "name": "lakomio",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.32.1",
  "engines": { "node": ">=20.0.0" },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint . --max-warnings 0",
    "lint:boundaries": "eslint . --max-warnings 0",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,md}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,md}\"",
    "typecheck": "tsc --noEmit",
    "audit:prod": "pnpm audit --prod --audit-level=high --ignore-registry-errors",
    "check": "pnpm lint && pnpm typecheck",
    "knip": "knip",
    "test": "vitest run",
    "test:watch": "vitest",
    "verify": "pnpm check && pnpm test && pnpm audit:prod",
    "supabase:types": "supabase gen types typescript --project-id $SUPABASE_PROJECT_ID > src/types/database.ts",
    "prepare": "husky || true"
  },
  "dependencies": {
    "@sentry/nextjs": "^10.51.0",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.108.2",
    "@upstash/ratelimit": "^2.0.8",
    "@upstash/redis": "^1.37.0",
    "@vercel/analytics": "^2.0.1",
    "@vercel/speed-insights": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^1.14.0",
    "next": "16.3.8",
    "posthog-js": "^1.391.2",
    "radix-ui": "^1.4.3",
    "react": "19.2.5",
    "react-dom": "19.2.5",
    "server-only": "^0.0.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.5.0",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.3",
    "@commitlint/config-conventional": "^20.5.3",
    "@commitlint/types": "^20.5.0",
    "@playwright/test": "^1.59.1",
    "@semantic-release/changelog": "^6.0.3",
    "@semantic-release/git": "^10.0.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^25",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "dotenv": "^17.4.2",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-boundaries": "^6.0.2",
    "eslint-plugin-import": "^2.32.0",
    "husky": "^9.1.7",
    "knip": "^6.11.0",
    "lint-staged": "^16.0.0",
    "prettier": "^3.8.3",
    "prettier-plugin-tailwindcss": "^0.8.0",
    "semantic-release": "^25.0.3",
    "shadcn": "^4.0.8",
    "tailwindcss": "^4",
    "tsx": "^4.21.0",
    "typescript": "^6",
    "vite": "7.3.5",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": "3.1.7",
      "postcss": ">=8.5.18",
      "sharp": ">=0.35.5",
      "js-yaml": ">=4.3.1 <5.0.0",
      "hono": ">=4.12.34 <5.0.0",
      "minimatch@3>brace-expansion": ">=1.1.18 <2.0.0",
      "minimatch@10>brace-expansion": "5.0.11",
      "nanoid": "3.3.18",
      "browserslist": "4.28.7",
      "source-map-js": "1.2.2",
      "@semantic-release/github>undici": ">=7.29.0 <8.0.0",
      "@actions/http-client>undici": ">=6.28.0 <7.0.0",
      "@hono/node-server": "^2.0.5",
      "dompurify": "^3.4.13",
      "@opentelemetry/core": "^2.8.0",
      "qs": "^6.15.2",
      "ip-address": "^10.1.1",
      "micromatch>picomatch": "^2.3.2",
      "@babel/core": ">=7.29.6 <8.0.0",
      "esbuild": ">=0.28.1"
    }
  },
  "lint-staged": {
    "src/**/*.{ts,tsx}": ["eslint --fix --max-warnings 0", "prettier --write"],
    "src/**/*.{css,md,json}": ["prettier --write"]
  }
}

